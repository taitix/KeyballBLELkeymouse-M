#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <26 11>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp Q     &kp W     &kp E     &kp R  &kp T                                 &kp Y  &kp U  &kp I      &kp O    &kp P            &kp BSPC
&kp LEFT_CONTROL  &kp A     &kp S     &kp D     &kp F  &kp G  &mkp MCLK     &kp MINUS        &kp H  &kp J  &kp K      &kp L    &lt 4 SEMICOLON  &kp ENTER
&kp LSHFT         &kp Z     &kp X     &kp C     &kp V  &kp B  &kp DELETE    &kp EQUAL        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH         &mo 2
&kp GRAVE         &kp LGUI  &kp LGUI  &kp LALT  &mo 3  &mo 2  &kp SPACE     &kp RIGHT_SHIFT  &mo 1                             &mo 6            &tog 4
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        FUNCTION {
            bindings = <
&kp ESCAPE  &kp F11  &kp F12  &kp SPACE  &kp SPACE  &kp PRINTSCREEN                       &kp PAGE_UP    &trans      &kp UP             &kp LBKT         &kp RBKT         &kp BSLH
&trans      &kp F1   &kp F2   &kp F3     &kp F4     &kp F5           &trans     &kp HOME  &kp PAGE_UP    &kp LEFT    &kp DOWN           &kp RIGHT_ARROW  &kp SQT          &kp DOUBLE_QUOTES
&trans      &kp F6   &kp F7   &kp F8     &kp F9     &kp F10          &kp F11    &kp END   &kp PAGE_DOWN  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_AC_SEARCH  &trans
&trans      &trans   &trans   &trans     &trans     &trans           &trans     &trans    &trans                                                         &trans           &trans
            >;
        };

        NUM {
            bindings = <
&kp ESCAPE  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)                                &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)
&trans      &kp N1        &kp N2      &kp N3         &kp N4        &kp N5         &kp LC(LA(C_MUTE))    &trans  &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &trans
&trans      &kp N6        &kp N7      &kp N8         &kp N9        &kp N0         &kp PERIOD            &trans  &kp N1         &kp N2        &kp N3        &kp N4        &kp N5        &trans
&trans      &trans        &trans      &trans         &trans        &trans         &trans                &trans  &kp PERIOD                                               &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ARROW {
            bindings = <
&trans  &kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                     &trans  &trans    &kp PAGE_UP    &trans   &trans  &trans
&trans  &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans    &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans    &trans  &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans          &trans                  &trans          &trans                   &trans   &trans    &trans  &trans                                    &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans              &kp LG(UP_ARROW)    &trans               &trans                           &kp C_AC_BACK     &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &mo 5              &kp PRINTSCREEN  &trans
&trans  &trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans    &kp HOME       &kp PAGE_UP       &mkp MB1         &mkp MB2           &mkp MB3           &trans           &trans
&trans  &trans  &trans              &trans              &trans               &trans  &trans    &kp END        &kp PAGE_DOWN     &kp C_MUTE       &kp C_VOLUME_DOWN  &kp C_VOLUME_DOWN  &trans           &trans
&trans  &trans  &trans              &trans              &trans               &trans  &trans    &kp C_AC_BACK  &kp C_AC_FORWARD                                                         &trans           &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &out OUT_BLE  &out OUT_USB  &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                  &bt BT_CLR_ALL  &bt BT_CLR_ALL
            >;
        };
    };
};
